;; report.aura — 生成报告：out/report.html（分数曲线 + 净值曲线 + KEEP/ROLLBACK 表）、audit.tsv、summary.json、
;; strategy.evolved.aura（进化后的程序，可以直接替换 strategy.aura 再跑一轮）

(define (html-esc s)
  (let loop ((cs (string->list (str s))) (acc (list)))
    (if (null? cs) (list->string (reverse acc))
        (let ((c (car cs)))
          (loop (cdr cs)
                (cond ((char=? c #\<) (append (reverse (string->list "&lt;")) acc))
                      ((char=? c #\>) (append (reverse (string->list "&gt;")) acc))
                      ((char=? c #\&) (append (reverse (string->list "&amp;")) acc))
                      (else (cons c acc))))))))

;; 线性映射
(define (sx x x0 x1 w) (+ 40.0 (* (- w 60.0) (/ (- x x0) (max 1e-9 (- x1 x0))))))
(define (sy y y0 y1 h) (- (- h 30.0) (* (- h 50.0) (/ (- y y0) (max 1e-9 (- y1 y0))))))

(define (svg-axes w h x0 x1 y0 y1 title)
  (format "<text x='40' y='16' font-size='13'>~a</text><line x1='40' y1='~a' x2='~a' y2='~a' stroke='#999'/><line x1='40' y1='20' x2='40' y2='~a' stroke='#999'/><text x='2' y='24' font-size='10'>~a</text><text x='2' y='~a' font-size='10'>~a</text><text x='40' y='~a' font-size='10'>~a</text><text x='~a' y='~a' font-size='10'>~a</text>"
          title (- h 30) (- w 20) (- h 30) (- h 30) (r3 y1) (- h 30) (r3 y0) (- h 15) x0 (- w 40) (- h 15) x1))

;; 分数曲线：每个被评测的候选一个点（绿 KEEP / 红 ROLLBACK），蓝线是当前版本分数
(define (score-svg curve s0 steps)
  (let* ((w 760.0) (h 280.0)
         (ys (cons s0 (map cadr curve)))
         (y0 (apply min ys)) (y1 (apply max ys)))
    (let loop ((pts curve) (inc s0) (lx 0) (path (format "M ~a ~a" (sx 0 0 steps w) (sy s0 y0 y1 h))) (dots ""))
      (if (null? pts)
          (format "<svg xmlns='http://www.w3.org/2000/svg' width='~a' height='~a'>~a<path d='~a H ~a' fill='none' stroke='#2563eb' stroke-width='2'/>~a</svg>"
                  w h (svg-axes w h 0 steps y0 y1 "训练集 Sharpe：点=候选，线=当前版本")
                  path (sx steps 0 steps w) dots)
          (let* ((p (car pts)) (st (car p)) (sc (cadr p)) (keep (equal? (caddr p) "KEEP"))
                 (inc2 (if keep sc inc))
                 (path2 (if keep (format "~a H ~a V ~a" path (sx st 0 steps w) (sy sc y0 y1 h)) path))
                 (dot (format "<circle cx='~a' cy='~a' r='3.5' fill='~a'><title>第 ~a 步 ~a</title></circle>"
                              (sx st 0 steps w) (sy sc y0 y1 h) (if keep "#16a34a" "#dc2626") st (r3 sc))))
            (loop (cdr pts) inc2 st path2 (string-append dots dot)))))))

(define (equity-path eq y0 y1 w h)
  (let* ((n (vector-length eq)))
    (let loop ((i 0) (acc ""))
      (if (>= i n) acc
          (loop (+ i 4) (string-append acc (format "~a ~a ~a " (if (= i 0) "M" "L") (sx i 0 n w) (sy (vector-ref eq i) y0 y1 h))))))))
(define (vec-min v) (let loop ((i 0) (m 1e18)) (if (>= i (vector-length v)) m (loop (+ i 1) (min m (vector-ref v i))))))
(define (vec-max v) (let loop ((i 0) (m -1e18)) (if (>= i (vector-length v)) m (loop (+ i 1) (max m (vector-ref v i))))))
(define (equity-svg e0 e1)
  (let* ((w 760.0) (h 260.0)
         (y0 (min (vec-min e0) (vec-min e1))) (y1 (max (vec-max e0) (vec-max e1))))
    (format "<svg xmlns='http://www.w3.org/2000/svg' width='~a' height='~a'>~a<path d='~a' fill='none' stroke='#9ca3af' stroke-width='1.5'/><path d='~a' fill='none' stroke='#16a34a' stroke-width='2'/></svg>"
            w h (svg-axes w h 0 (vector-length e0) y0 y1 "留出集净值：灰=初始策略，绿=进化后")
            (equity-path e0 y0 y1 w h) (equity-path e1 y0 y1 w h))))

(define (metrics-row label res)
  (let ((t (car res)) (v (cadr res)))
    (format "<tr><td>~a</td><td>~a</td><td>~a</td><td>~a</td><td>~a</td><td>~a</td></tr>"
            label (r3 (hash-ref t "sharpe")) (r3 (hash-ref t "maxdd")) (hash-ref t "trades")
            (r3 (hash-ref v "sharpe")) (r3 (hash-ref v "maxdd")))))

(define (audit-rows audit)
  (string-join
    (map (lambda (row)
           (let ((d (list-ref row 6)))
             (format "<tr class='~a'>~a</tr>" (string-downcase d)
                     (string-join (map (lambda (c) (string-append "<td>" (html-esc c) "</td>")) row) ""))))
         audit) ""))

;; write-file 失败（目录不存在、权限等）时只返回 ()，不报错（见 aura DX friction log），所以这里读回检查。
;; 不用 std/fs 的 file-exists?：require "std/fs" 在默认沙箱里要求 write 权限，会让整个 kit 加载失败。
(define (write-file! path text)
  (write-file path text)
  (if (null? (read-file path))
      (error (string-append "写文件失败：" path "（输出目录要先建好；scripts/run-kit.sh 会自动建）"))
      #t))

(define (write-report! dir out steps seed train val e0 e1 elapsed-ms)
  (let* ((res0 (hash-ref out "res0")) (res (hash-ref out "res")) (audit (hash-ref out "audit")))
    ;; audit.tsv
    (write-file! (string-append dir "/audit.tsv")
                (lines->text (cons "step\tmutation\ttrain_sharpe\ttrain_maxdd\ttrades\tval_sharpe\tdecision\treason\tmutate_ms\teval_ms"
                                   (map (lambda (row) (string-join (map str row) "\t")) audit))))
    ;; 进化后的程序
    (write-file! (string-append dir "/strategy.evolved.aura")
                (string-append ";; 由 evolve-strategy 生成（seed " (str seed) "，" (str steps) " 步）。可以直接替换 strategy.aura 再跑一轮。\n"
                               "(define strategy-params " (params->src (hash-ref out "ps")) ")\n"
                               "(define strategy-rules " (rules->src (hash-ref out "rules")) ")\n"))
    ;; summary.json（CI 用它比对确定性结果）
    (write-file! (string-append dir "/summary.json")
                (format "{\"seed\": ~a, \"steps\": ~a, \"keeps\": ~a, \"rollbacks\": ~a, \"illegal\": ~a, \"dups\": ~a, \"train_sharpe_before\": ~a, \"train_sharpe_after\": ~a, \"val_sharpe_before\": ~a, \"val_sharpe_after\": ~a, \"train_maxdd_after\": ~a, \"params\": \"~a\", \"rules\": \"~a\"}\n"
                        seed steps (hash-ref out "keeps") (hash-ref out "rollbacks") (hash-ref out "illegal") (hash-ref out "dups")
                        (r3 (hash-ref (car res0) "sharpe")) (r3 (hash-ref (car res) "sharpe"))
                        (r3 (hash-ref (cadr res0) "sharpe")) (r3 (hash-ref (cadr res) "sharpe"))
                        (r3 (hash-ref (car res) "maxdd")) (hash-ref out "ps") (hash-ref out "rules")))
    ;; report.html
    (write-file! (string-append dir "/report.html")
      (string-append
        "<!doctype html><html lang='zh'><meta charset='utf-8'><title>evolve-strategy 报告</title>"
        "<style>body{font-family:sans-serif;max-width:900px;margin:20px auto;padding:0 12px}table{border-collapse:collapse;font-size:13px}td,th{border:1px solid #ddd;padding:3px 6px}tr.keep{background:#dcfce7}tr.rollback{background:#fee2e2}tr.illegal,tr.dup{color:#888}</style>"
        "<h1>evolve-strategy 进化报告</h1>"
        (format "<p>合成行情：训练 seed ~a、留出 seed ~a，各 ~a 根 bar。进化 ~a 步（seed ~a），KEEP ~a，ROLLBACK ~a，契约拦截 ~a，重复跳过 ~a，用时 ~a ms。</p>"
                (hash-ref train "seed") (hash-ref val "seed") (hash-ref train "n") steps seed
                (hash-ref out "keeps") (hash-ref out "rollbacks") (hash-ref out "illegal") (hash-ref out "dups") elapsed-ms)
        "<table><tr><th></th><th>训练 Sharpe</th><th>训练最大回撤</th><th>交易次数</th><th>留出 Sharpe</th><th>留出最大回撤</th></tr>"
        (metrics-row "初始" res0) (metrics-row "进化后" res) "</table>"
        (format "<p>初始：<code>~a ~a</code><br>进化后：<code>~a ~a</code></p>"
                (html-esc (hash-ref out "ps0")) (html-esc (hash-ref out "rules0")) (html-esc (hash-ref out "ps")) (html-esc (hash-ref out "rules")))
        (score-svg (hash-ref out "curve") (hash-ref (car res0) "sharpe") steps)
        (equity-svg e0 e1)
        "<h2>每一步</h2><table><tr><th>步</th><th>变更</th><th>训练 Sharpe</th><th>回撤</th><th>交易</th><th>留出 Sharpe</th><th>裁决</th><th>原因</th><th>变更 ms</th><th>评测 ms</th></tr>"
        (audit-rows audit) "</table>"
        "<h2>Aura mutation-log（运行结束时）</h2><pre>" (html-esc (query :mutation-log)) "</pre></html>\n"))))
