;; main.aura — evolve-strategy 入口
;;   KIT_STEPS（默认 60）进化步数；KIT_SEED（默认 1）提议用的随机种子；KIT_OUT（默认 out）输出目录
(require "./util")
(require "./market")
(require "./backtest")
(require "./gate")
(require "./evolve")
(require "./report")

(define steps (string->number (env-or "KIT_STEPS" "60")))
(define seed (string->number (env-or "KIT_SEED" "1")))
(define out-dir (env-or "KIT_OUT" "out"))
(define t0 (current-time-ms))

;; 1. 把初始程序装进 live AST
(set-code (read-file (env-or "KIT_STRATEGY" "strategy.aura")))
(eval-current)

;; 2. 两条确定性合成行情：训练 / 留出
(define train (make-market 7 1000))
(define val (make-market 11 1000))

;; 3. 进化
(define out (evolve! steps seed train val))

;; 4. 报告
(define e0 (hash-ref (backtest val (hash-ref out "ps0") (hash-ref out "rules0") #t) "equity"))
(define e1 (hash-ref (backtest val (hash-ref out "ps") (hash-ref out "rules") #t) "equity"))
(write-report! out-dir out steps seed train val e0 e1 (- (current-time-ms) t0))

(display (format "evolve-strategy: ~a 步，KEEP ~a，ROLLBACK ~a，契约拦截 ~a，重复 ~a\n"
                 steps (hash-ref out "keeps") (hash-ref out "rollbacks") (hash-ref out "illegal") (hash-ref out "dups")))
(display (format "训练 Sharpe ~a → ~a，留出 Sharpe ~a → ~a，训练最大回撤 ~a\n"
                 (r3 (hash-ref (car (hash-ref out "res0")) "sharpe")) (r3 (hash-ref (car (hash-ref out "res")) "sharpe"))
                 (r3 (hash-ref (cadr (hash-ref out "res0")) "sharpe")) (r3 (hash-ref (cadr (hash-ref out "res")) "sharpe"))
                 (r3 (hash-ref (car (hash-ref out "res")) "maxdd"))))
(display (format "进化后：~a ~a\n" (hash-ref out "ps") (hash-ref out "rules")))
(display (format "报告：~a/report.html（审计 ~a/audit.tsv）\n" out-dir out-dir))
