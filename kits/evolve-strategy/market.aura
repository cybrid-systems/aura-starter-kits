;; market.aura — 确定性合成行情（不含任何真实数据）
;;
;; 分段的"体制切换"随机游走：每段 60–180 个 bar，段内漂移 / 波动率固定。
;; 同一个种子永远生成同一条序列，所以结果可复现、可以在 CI 里比对。

(define (rng-make seed) (list (modulo (+ (* seed 7919) 12345) 2147483647)))
(define (rng-next! r)
  (let ((v (modulo (+ (* (car r) 1103515245) 12345) 2147483648)))
    (set-car! r v)
    v))
(define (rng-int! r n) (modulo (quotient (rng-next! r) 16) n))
(define (rng-float! r) (/ (* 1.0 (rng-int! r 1000000)) 1000000.0))
;; 12 个均匀分布之和 - 6 ≈ 标准正态
(define (rng-normal! r)
  (let loop ((i 0) (s 0.0))
    (if (= i 12) (- s 6.0) (loop (+ i 1) (+ s (rng-float! r))))))

(define *regimes*
  (list (list 0.0009 0.009)     ;; 平稳上涨
        (list -0.0008 0.011)    ;; 平稳下跌
        (list 0.0 0.006)        ;; 低波动震荡
        (list 0.0 0.028)))      ;; 高波动震荡（趋势策略在这里亏钱）

;; 返回 hash：close / ret / csum（收盘价前缀和）/ vsum（收益平方前缀和）/ n
(define (make-market seed n)
  (let* ((r (rng-make seed))
         (close (make-vector n 0.0))
         (ret (make-vector n 0.0))
         (csum (make-vector (+ n 1) 0.0))
         (vsum (make-vector (+ n 1) 0.0)))
    (let loop ((i 0) (p 100.0) (left 0) (mu 0.0) (sig 0.01))
      (if (< i n)
          (let* ((new-seg (<= left 0))
                 (reg (if new-seg (list-ref *regimes* (rng-int! r (length *regimes*))) #f))
                 (mu2 (if new-seg (car reg) mu))
                 (sig2 (if new-seg (cadr reg) sig))
                 (left2 (if new-seg (+ 60 (rng-int! r 121)) left))
                 (x (if (= i 0) 0.0 (+ mu2 (* sig2 (rng-normal! r)))))
                 (p2 (* p (+ 1.0 x))))
            (vector-set! close i p2)
            (vector-set! ret i x)
            (vector-set! csum (+ i 1) (+ (vector-ref csum i) p2))
            (vector-set! vsum (+ i 1) (+ (vector-ref vsum i) (* x x)))
            (loop (+ i 1) p2 (- left2 1) mu2 sig2))
          #f))
    (hash "close" close "ret" ret "csum" csum "vsum" vsum "n" n "seed" seed)))

(define (mkt m k) (hash-ref m k))
;; 截止 i（含）的 w 根均线；数据不够时返回 #f
(define (sma m i w)
  (if (< i (- w 1)) #f
      (let ((cs (mkt m "csum")))
        (/ (- (vector-ref cs (+ i 1)) (vector-ref cs (+ (- i w) 1))) (* 1.0 w)))))
;; 截止 i 的 w 根年化波动率
(define (rvol m i w)
  (if (< i w) #f
      (let ((vs (mkt m "vsum")))
        (sqrt (* 252.0 (/ (- (vector-ref vs (+ i 1)) (vector-ref vs (+ (- i w) 1))) (* 1.0 w)))))))
